/*
    nilt version macros.

    Generated by CMake from `include/nilt/version.hpp.in`.  Do NOT edit the
    generated file directly; update the version in the top-level
    `CMakeLists.txt` instead.

    Use:
        #include <nilt/version.hpp>

        static_assert(NILT_VERSION_MAJOR >= 3, "requires nilt >= 3.x");
        std::cout << NILT_VERSION_STRING << '\n';
*/
#ifndef NILT_VERSION_HEADER
#define NILT_VERSION_HEADER

#define NILT_VERSION_MAJOR  @NILT_VERSION_MAJOR@
#define NILT_VERSION_MINOR  @NILT_VERSION_MINOR@
#define NILT_VERSION_PATCH  @NILT_VERSION_PATCH@
#define NILT_VERSION_STRING "@NILT_VERSION@"

#endif // NILT_VERSION_HEADER
